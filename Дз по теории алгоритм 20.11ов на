#include <iostream>
#include <string>
using namespace std;
struct Bus {
    string model;
    int year;
    string color;
    int capacity;
};
void insertionSort(Bus arr[], int n) {
    for (int i = 1; i < n; i++) {
        Bus key = arr[i];
        int j = i - 1;

        while (j >= 0 && (arr[j].capacity < key.capacity ||
               (arr[j].capacity == key.capacity && arr[j].year > key.year))) {
            arr[j + 1] = arr[j];
            j--;
        }
        arr[j + 1] = key;
    }
}
void printBuses(const Bus arr[], int n) {
    for (int i = 0; i < n; i++) {
        cout << arr[i].model << " | "
             << arr[i].year << " | "
             << arr[i].color << " | "
             << arr[i].capacity << endl;
    }
}
int main() {
    const int n = 4;
    Bus buses[n] = {
        {"Mercedes Sprinter", 2020, "White", 22},
        {"Iveco Crossway", 2018, "Blue", 45},
        {"Mercedes Sprinter", 2022, "Black", 22},
        {"MAN Lion's City", 2021, "Red", 45}
    };
    insertionSort(buses, n);
    printBuses(buses, n);

    return 0;
}
