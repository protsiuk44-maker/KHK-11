#include <iostream>
#include <fstream>
using namespace std;
int main()
{
    int words = 0;
    int lines = 0;
    char text[100];
    ofstream out("Text.txt", ios::out | ios::trunc); // создание текстового файла 
    if (!out) {
        cout << "Error!"; // если не удается открвть файл то вивод ерор
        return 1;
    }
    while (cin.getline(text, 100))
    {
        if (text[0] == 'E' && text[1] == 'N' && text[2] == '' && text[3] == ' ') {
         break;
        }

        out << text << endl;
    }
    out.close();// закритие файлового потока 

    ifstream in("Text.txt");
    char ch;
    bool inWord = false;
    while (in.get(ch))
    {
        if (ch == '\n')
            lines++;

        if (ch != ' ' && ch != ' ' && ch != ' ')
        {
            if (!inWord)
            {
                words++;
                inWord = true;
            }
        }
        else
        {
            inWord = false;
        }
    }
    in.close();
    cout << "Lines " << lines << endl;
    cout << "Words " << words << endl;
    return 0;
}
