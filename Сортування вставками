#include <iostream>
using namespace std;
class Sorter {
private:
    int* arr;
    nt size;
public:
    Sorter(int inputArr[], int n) {
        size = n;
        arr = new int[size];
        for (int i = 0; i < size; i++) {
            arr[i] = inputArr[i];
        }
    }
    ~Sorter() {
        delete[] arr;
    }
    void print() {
        for (int i = 0; i < size; i++) {
            cout << arr[i] << " ";
        }
        cout << endl;
    }

    int bubbleSort() {
        int* temp = new int[size];
        for (int i = 0; i < size; i++) {
            temp[i] = arr[i];
        }

        int iterations = 0;
        for (int i = 0; i < size - 1; i++) {
            for (int j = 0; j < size - i - 1; j++) {
                iterations++;
                if (temp[j] > temp[j + 1]) {
                    int t = temp[j];
                    temp[j] = temp[j + 1];
                    temp[j + 1] = t;
                }
            }
        }

        delete[] temp;
        return iterations;
    }

    int insertionSort() {
        int iterations = 0;

        for (int i = 1; i < size; i++) {
            int key = arr[i];
            int j = i - 1;

            while (j >= 0 && arr[j] > key) {
                iterations++;
                arr[j + 1] = arr[j];
                j--;
            }
            if (j >= 0) {
                iterations++;
            }

            arr[j + 1] = key;
        }

        return iterations;
    }
};
int main() {
    int myArr[] = {29, 10, 14, 37, 13, 5, 42};
    int n = 7;
    Sorter s(myArr, n);
    cout << "До сортування: ";
    s.print();
    int bubbleIter = s.bubbleSort();
    int insertIter = s.insertionSort();
    cout << "Після сортування: ";
    s.print();
    cout << "Ітерацій бульбашкою: " << bubbleIter << endl;
    cout << "Ітерацій вставками:  " << insertIter << endl;
    return 0;
}
